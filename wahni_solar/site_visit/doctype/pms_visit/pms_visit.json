{
 "doctype": "DocType",
 "name": "PMS Visit",
 "module": "Site Visit",
 "engine": "InnoDB",
 "autoname": "format:PMS-{YYYY}-{#####}",
 "allow_rename": 1,
 "title_field": "client_name",
 "show_title_field_in_link": 1,
 "search_fields": "project,customer,client_name,place,service_person,service_person_name",
 "track_changes": 1,
 "make_attachments_public": 0,
 "field_order": [
  "visit_details", "status", "pms_date", "service_person", "service_person_name", "project", "customer", "client_name",
  "details_column", "place", "plant_capacity_kw", "site_location_link",
  "inspection", "ac_db_string_inverter", "inverter_name_plate", "ac_db", "dc_db",
  "images_column", "panel_image", "house_image", "additional_image",
  "remarks_section", "inspection_remarks", "legacy_site_data_collection"
 ],
 "fields": [
  {"fieldname": "visit_details", "fieldtype": "Section Break", "label": "PMS Visit Details"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Assigned\nIn Progress\nCompleted", "default": "Assigned", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "no_copy": 1},
  {"fieldname": "pms_date", "fieldtype": "Date", "label": "PMS Date", "mandatory_depends_on": "eval:doc.status == 'Completed'", "in_list_view": 1},
  {"fieldname": "service_person", "fieldtype": "Link", "label": "Service Person Name", "options": "Employee", "mandatory_depends_on": "eval:!doc.legacy_site_data_collection && (doc.__islocal || !doc.service_person_name)", "in_list_view": 1, "in_standard_filter": 1, "description": "Assigned supervisor: an active Employee whose enabled User has the Project Supervisor role."},
  {"fieldname": "service_person_name", "fieldtype": "Data", "label": "Legacy Service Person Name", "depends_on": "eval:!doc.service_person && !!doc.service_person_name && !doc.__islocal", "description": "Historical name retained for reports created before Employee linking."},
  {"fieldname": "project", "fieldtype": "Link", "label": "Project", "options": "Project", "mandatory_depends_on": "eval:!doc.legacy_site_data_collection", "in_standard_filter": 1, "in_list_view": 1, "description": "Required for new visits. Only completed Projects can be selected; imported historical reports may have no Project."},
  {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer", "in_list_view": 1},
  {"fieldname": "client_name", "fieldtype": "Data", "label": "Client Name", "in_list_view": 1, "depends_on": "eval:!doc.customer", "mandatory_depends_on": "eval:!doc.customer", "description": "Enter a client name only when no Customer is selected."},
  {"fieldname": "details_column", "fieldtype": "Column Break"},
  {"fieldname": "place", "fieldtype": "Data", "label": "Place", "mandatory_depends_on": "eval:doc.status == 'Completed'"},
  {"fieldname": "plant_capacity_kw", "fieldtype": "Float", "label": "Plant Capacity (kW)", "mandatory_depends_on": "eval:doc.status == 'Completed'", "description": "Retained for compatibility with historical Site Data Collection reports."},
  {"fieldname": "site_location_link", "fieldtype": "Data", "label": "Site Location Link", "options": "URL", "mandatory_depends_on": "eval:doc.status == 'Completed'"},
  {"fieldname": "inspection", "fieldtype": "Section Break", "label": "Inspection Photos"},
  {"fieldname": "ac_db_string_inverter", "fieldtype": "Attach Image", "label": "AC DB and String Inverter", "mandatory_depends_on": "eval:doc.status == 'Completed'", "description": "Only AC DB and monitoring DB if the system is micro-inverter based."},
  {"fieldname": "inverter_name_plate", "fieldtype": "Attach Image", "label": "Inverter Name Plate"},
  {"fieldname": "ac_db", "fieldtype": "Attach Image", "label": "AC DB Components", "description": "Ratings of components should be clearly readable."},
  {"fieldname": "dc_db", "fieldtype": "Attach Image", "label": "DC DB Components", "description": "Ratings of components should be clearly readable."},
  {"fieldname": "images_column", "fieldtype": "Column Break"},
  {"fieldname": "panel_image", "fieldtype": "Attach Image", "label": "Panel Image", "mandatory_depends_on": "eval:doc.status == 'Completed'", "description": "Include the lightning arrestor."},
  {"fieldname": "house_image", "fieldtype": "Attach Image", "label": "House Image", "mandatory_depends_on": "eval:doc.status == 'Completed'", "description": "Front view to identify the house."},
  {"fieldname": "additional_image", "fieldtype": "Attach Image", "label": "Additional Image"},
  {"fieldname": "remarks_section", "fieldtype": "Section Break", "label": "Inspection Remarks"},
  {"fieldname": "inspection_remarks", "fieldtype": "Text", "label": "Inspection Remarks", "mandatory_depends_on": "eval:doc.status == 'Completed'"},
  {"fieldname": "legacy_site_data_collection", "fieldtype": "Data", "label": "Legacy Site Data Collection", "read_only": 1, "hidden": 1, "unique": 1, "no_copy": 1, "description": "Retained only for existing UAT reports allowed without a Project. Cannot be set on new visits."}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "email": 1, "report": 1, "export": 1, "share": 1},
  {"role": "Sales User", "read": 1, "write": 1, "create": 1, "print": 1, "report": 1},
  {"role": "Project Supervisor", "read": 1, "write": 1, "create": 1, "print": 1, "report": 1},
  {"role": "Projects User", "read": 1, "print": 1, "report": 1},
  {"role": "Projects Manager", "read": 1, "write": 1, "create": 1, "print": 1, "report": 1}
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "states": [
  {"title": "Assigned", "color": "Blue"},
  {"title": "In Progress", "color": "Orange"},
  {"title": "Completed", "color": "Green"}
 ],
 "creation": "2026-11-13 16:00:00.000000",
 "modified": "2026-11-17 19:00:00.000000",
 "modified_by": "Administrator",
 "owner": "Administrator"
}
