{
 "doctype": "DocType",
 "name": "Solar Package Input",
 "module": "Wahni Solar Proposal",
 "engine": "InnoDB",
 "field_order": [
  "variable_key",
  "label",
  "input_type",
  "uom",
  "default_value",
  "select_options",
  "show_when",
  "required"
 ],
 "fields": [
  {
   "fieldname": "variable_key",
   "fieldtype": "Data",
   "label": "Variable Key",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Unique expression identifier, for example db_loop_length. Core variables and helper names are reserved."
  },
  {
   "fieldname": "label",
   "fieldtype": "Data",
   "label": "Label",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "input_type",
   "fieldtype": "Select",
   "label": "Input Type",
   "options": "Int\nFloat\nCheck\nSelect\nData",
   "default": "Float",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Unit",
   "options": "UOM"
  },
  {
   "fieldname": "default_value",
   "fieldtype": "Data",
   "label": "Default Value",
   "in_list_view": 1,
   "description": "Literal value, not a formula. Use an integer, a finite number, 0/1 for Check, or one of the Select choices."
  },
  {
   "fieldname": "select_options",
   "fieldtype": "Small Text",
   "label": "Choices",
   "depends_on": "eval:doc.input_type == \"Select\"",
   "description": "One choice per line. Required for Select inputs."
  },
  {
   "fieldname": "show_when",
   "fieldtype": "Small Text",
   "label": "Show When",
   "description": "Blank means always visible. Optional boolean expression, for example include_battery."
  },
  {
   "fieldname": "required",
   "fieldtype": "Check",
   "label": "Required",
   "default": "0"
  }
 ],
 "permissions": [],
 "actions": [],
 "links": [],
 "states": [],
 "sort_field": "modified",
 "sort_order": "DESC",
 "istable": 1,
 "editable_grid": 1
}
