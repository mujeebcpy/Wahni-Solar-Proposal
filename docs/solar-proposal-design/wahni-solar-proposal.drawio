        <mxCell id="proposal-cell-153" value="Auto status; staff explains any site override" vertex="1" parent="1" style="html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=DejaVu Sans;fontSize=16;fontStyle=0;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#CBD5E1;">
          <mxGeometry x="730" y="2583" width="420" height="62" as="geometry" />
        </mxCell>
        <mxCell id="proposal-cell-154" value="Missing valuation is visibly different from a confirmed zero-rate row." vertex="1" parent="1" style="html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=DejaVu Sans;fontSize=16;fontStyle=0;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#CBD5E1;">
          <mxGeometry x="1150" y="2583" width="610" height="62" as="geometry" />
        </mxCell>
        <mxCell id="proposal-cell-155" value="Site quantity overrides apply to included rows, are recorded with a reason, and feed dependent calculations. For example, overriding clamps from 50 to 60 makes a two-screws-per-clamp formula&#10;produce 120 screws. Excluded rows stay at zero. Ordinary recalculation uses saved definitions and rates; it does not reload edited master records." vertex="1" parent="1" style="html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=DejaVu Sans;fontSize=17;fontStyle=0;fontColor=#475569;fillColor=none;strokeColor=none;">
          <mxGeometry x="28" y="2667" width="1744" height="64" as="geometry" />
        </mxCell>
        <mxCell id="proposal-cell-156" value="Regenerate deliberately reloads current definitions and replaces the generated snapshot only after the complete calculation succeeds. It preserves site-entered input values, adds defaults for new&#10;inputs, and explicitly resets direct material-quantity overrides. Reprice refreshes valuation estimates without changing material quantities. Ordinary save / reopen preserves the existing snapshots&#10;and overrides." vertex="1" parent="1" style="html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=DejaVu Sans;fontSize=17;fontStyle=0;fontColor=#475569;fillColor=none;strokeColor=none;">
          <mxGeometry x="28" y="2743" width="1744" height="88" as="geometry" />
        </mxCell>
        <mxCell id="proposal-cell-157" value="All evaluations and final totals use one server calculation service. The form previews the same service; API-created proposals and browser edits must pass the same validation." vertex="1" parent="1" style="html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=DejaVu Sans;fontSize=17;fontStyle=0;fontColor=#475569;fillColor=none;strokeColor=none;">
          <mxGeometry x="28" y="2843" width="1744" height="40" as="geometry" />
        </mxCell>
        <mxCell id="proposal-cell-158" value="WAHNI SOLAR | Proposed data-entry tables | 5 - Solar Proposal | 23 Oct 2026" vertex="1" parent="1" style="html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontFamily=DejaVu Sans;fontSize=13;fontStyle=0;fontColor=#64748B;fillColor=none;strokeColor=none;">
          <mxGeometry x="28" y="2937" width="1744" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
